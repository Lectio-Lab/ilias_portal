# Local-only agent kit defaults (macOS). Generated on install.
SECRET_KEY=replace-me-on-install
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DB_NAME=ilias_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434

# Bind API to loopback only; MCP talks to localhost.
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8010

# Use installed Chrome for MFA (set by install.sh on macOS when Chrome is present)
# PLAYWRIGHT_BROWSER_CHANNEL=chrome

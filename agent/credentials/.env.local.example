# Portal account (used only to talk to our Django API)
PORTAL_EMAIL=you@example.com
PORTAL_PASSWORD=your-portal-password

# ILIAS university login (zx account, 7 chars e.g. zxofp67)
ILIAS_USERNAME=zx*****
ILIAS_PASSWORD=your-ilias-password

# Target course for demo publish (7-digit ILIAS course ref ID)
ILIAS_COURSE_ID=5658784

# Optional: additional courses, comma-separated
# ILIAS_COURSE_IDS=5658784,5658785

API_BASE_URL=http://localhost:8000

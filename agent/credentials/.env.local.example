# Run scripts/provision-interactive-auth.sh (or ./install.sh) to generate this value.
PORTAL_LOCAL_TOKEN=

# University credentials MUST stay blank.
# Enter username/password only in the interactive browser MFA window.
# Never put ILIAS_PASSWORD in this file — it is never stored by the kit.
# Choose courses after interactive login.
ILIAS_COURSE_ID=

ILIAS_COURSE_IDS=

API_BASE_URL=http://127.0.0.1:8010
